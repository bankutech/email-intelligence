# --- Gmail ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# Google OAuth via Environment Variables (Recommended for Vercel / Cloud / Docker)
# You can use these instead of credentials.json:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or paste entire credentials.json content here (raw or base64):
GOOGLE_CREDENTIALS_JSON=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Worker ---
POLL_INTERVAL=60                # seconds between Gmail checks
CONFIDENCE_THRESHOLD=0.85       # >= this: automatic action
REVIEW_THRESHOLD=0.60           # below this: AI-REVIEW only (0.60-0.84 also AI-REVIEW)
MAX_ATTEMPTS=5                  # retries for permanent per-email errors
INITIAL_LOOKBACK_DAYS=1         # first run only: how far back to look
MAX_BODY_CHARS=4000             # body characters sent to the LLM
LLM_MAX_RETRIES=3
RETRY_BASE_DELAY=1.0            # seconds, doubles each retry

# --- Safety ---
DRY_RUN=false                   # true = classify + log, never modify Gmail
SPAM_POLICY=quarantine          # label | quarantine | spam

# --- Storage ---
DATABASE_PATH=data/emails.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Optional notifications (Slack/Discord-style webhook) ---
NOTIFY_WEBHOOK_URL=

# --- Dashboard & Security ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_SHOW_SUBJECT=true
SESSION_SECRET_KEY=generate-a-random-cryptographic-secret-at-least-32-chars-long
# Optional dedicated key for database token encryption at rest (defaults to SESSION_SECRET_KEY if not specified)
TOKEN_ENCRYPTION_KEY=
